<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="baseBtn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="digitBtn" parent="baseBtn">
        <item name="android:backgroundTint">@color/digit</item>
    </style>

    <style name="operatorBtn" parent="baseBtn">
        <item name="android:backgroundTint">@color/operator</item>
    </style>

    <style name="memoryBtn" parent="baseBtn">
        <item name="android:backgroundTint">@color/memory</item>
    </style>

    <style name="controlBtn" parent="baseBtn">
        <item name="android:backgroundTint">@color/control</item>
    </style>

</resources>